{
  "name": "lich-truc-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "preflight:changed": "node scripts/preflight-changed.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:db": "supabase test db",
    "test:e2e:required": "playwright test tests/e2e/accessibility-smoke.spec.ts",
    "test:e2e:evidence-off": "playwright test --config playwright.evidence-off.config.ts",
    "test:e2e:production-smoke:run": "playwright test --config=playwright.production.config.ts",
    "test:e2e:production-smoke": "npm run build && npm run test:e2e:production-smoke:run",
    "test:e2e:full-local": "playwright test --config playwright.full-local.config.ts",
    "test:e2e": "npm run test:e2e:full-local",
    "check": "npm run lint && npm run typecheck && npm test",
    "react-doctor:audit": "react-doctor . --verbose -y --project . --scope full --no-telemetry --blocking none --max-duration 180",
    "openspec": "openspec",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/database.types.ts",
    "personnel:bootstrap": "node scripts/bootstrap-personnel-security.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/red-hat-display": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "5.2.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "next": "16.3.8",
    "papaparse": "5.5.3",
    "pdfkit": "^0.19.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.62.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@fission-ai/openspec": "^1.7.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.3.16",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.3",
    "supabase": "2.110.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "5.4.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.4"
  },
  "type": "module"
}
